# ============================================================
# Lomhifar B2B — Variables de entorno
# Railway las inyecta desde el panel del servicio web.
# ============================================================

# --- BASE DE DATOS ---
# Railway crea automáticamente esta variable cuando enlazas el servicio
# PostgreSQL. Si la creas manualmente: postgresql://user:pass@host:5432/db
DATABASE_URL="postgresql://user:password@host:5432/lomhifar"

# --- SESIONES ---
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres"

# --- ADMIN INICIAL ---
# Creado por prisma/seed.ts en el primer arranque. Cambia la contraseña
# tras el primer login (entra en /admin/login y actualiza desde la BD).
ADMIN_EMAIL="admin@lomhifar.com"
ADMIN_PASSWORD="CambiaEstaPasswordTrasPrimerLogin!"

# --- SMTP (envío de emails) ---
# Compatible con IONOS, Outlook365, Gmail, SendGrid, etc.
SMTP_HOST="smtp.ionos.es"
SMTP_PORT="587"
SMTP_SECURE="false"            # "true" solo si usas el puerto 465 (SSL directo)
SMTP_USER="pedidos@lomhifar.com"
SMTP_PASSWORD="tu-password-smtp"
SMTP_FROM_NAME="Lomhifar Farmacia"
SMTP_FROM_EMAIL="pedidos@lomhifar.com"

# --- DESTINATARIOS DE PEDIDOS ---
# Email(es) que reciben los pedidos de las farmacias (separar por coma).
# Esta variable también se puede modificar después desde /admin/configuracion.
ORDERS_RECIPIENT_EMAILS="pedidos@lomhifar.com"

# --- URL PÚBLICA ---
# Dominio de Railway o personalizado. Se usa en los enlaces dentro de los emails.
NEXT_PUBLIC_APP_URL="https://pedidos.lomhifar.com"

# ============================================================
# Variables OPCIONALES (no usar en producción)
# ============================================================

# PREVIEW_BYPASS_CODE="true"
#   → Si está activa, las farmacias entran directo con CIF+email
#     sin pedir código de 6 dígitos. SOLO PARA PREVIEW LOCAL.
